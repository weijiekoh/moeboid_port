// ZapSpot.exe RT_DIALOG DUMPINFO, language 0x0409, DLGTEMPLATE, 2000 bytes, file offset 0x69450
// Pixel values: dialog base units 6x13 (MS Sans Serif 8pt strike from sserife.fon, 96 DPI). Client area only; frame size depends on the non-client metrics.
DUMPINFO DIALOG 0, 0, 320, 122
// client px: x=0 y=0 w=480 h=198
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_CAPTION | WS_POPUP   // 0x80C008C0
CAPTION "Unexpected Error Occurred"
FONT 8, "MS Sans Serif"   // DLGTEMPLATE: weight, italic and charset are not stored
BEGIN
    CONTROL "Close ZapSpot", 1, "Button", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 163, 101, 66, 16
        // id=1 (0x1) style=0x50030001 exstyle=0x00000000 | px x=245 y=164 w=99 h=26
    CONTROL "Zapspot has encountered an unexpected error and needs to be shut down.  This dialog gathers key ZapSpot specific system information which will help us fix the problem that you have run", -1, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 7, 302, 18
        // id=-1 (0xFFFF) style=0x50020000 exstyle=0x00000000 | px x=11 y=11 w=453 h=29
    CONTROL "To do so, please click the ""Copy to Clipboard button"" on this dialog.  Then, open up your email and write an email to Support@ZapSpot.com.  Please include a description of what happened", -1, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 36, 301, 18
        // id=-1 (0xFFFF) style=0x50020000 exstyle=0x00000000 | px x=11 y=59 w=452 h=29
    CONTROL "To see the information that will be copied, click the "">>"" button.", -1, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 74, 302, 8
        // id=-1 (0xFFFF) style=0x50020000 exstyle=0x00000000 | px x=11 y=120 w=453 h=13
    CONTROL "We apologize for the inconvenience and promise to address these issues immediately.", -1, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 87, 302, 8
        // id=-1 (0xFFFF) style=0x50020000 exstyle=0x00000000 | px x=11 y=141 w=453 h=13
    CONTROL ">>", 2010, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 303, 104, 12, 16
        // id=2010 (0x7DA) style=0x50030000 exstyle=0x00000000 | px x=455 y=169 w=18 h=26
    CONTROL "Copy to Clipboard", 2008, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 89, 101, 68, 16
        // id=2008 (0x7D8) style=0x50030000 exstyle=0x00000000 | px x=134 y=164 w=102 h=26
    CONTROL "into.  We would like to ask you to help us out by sending us this information in an email.", -1, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 23, 302, 8
        // id=-1 (0xFFFF) style=0x50020000 exstyle=0x00000000 | px x=11 y=37 w=453 h=13
    CONTROL "and then use your email program's Paste function to place the information from this dialog into your email.  When you're ready, send the mail to us and we will respond as soon as possible", -1, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 7, 53, 301, 18
        // id=-1 (0xFFFF) style=0x50020000 exstyle=0x00000000 | px x=11 y=86 w=452 h=29
END
