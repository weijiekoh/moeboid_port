// ZapSpot.exe RT_DIALOG IDD_QUIT_SAVED, language 0x0409, DLGTEMPLATE, 310 bytes, file offset 0x68A28
// Pixel values: dialog base units 6x13 (MS Sans Serif 8pt strike from sserife.fon, 96 DPI). Client area only; frame size depends on the non-client metrics.
IDD_QUIT_SAVED DIALOG 0, 0, 198, 50
// client px: x=0 y=0 w=297 h=81
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_CAPTION | WS_POPUP   // 0x80C008C0
CAPTION "Warning: Game in Progress"
FONT 8, "MS Sans Serif"   // DLGTEMPLATE: weight, italic and charset are not stored
BEGIN
    CONTROL "&No", 2001, "Button", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 102, 27, 50, 16
        // id=2001 (0x7D1) style=0x50030001 exstyle=0x00000000 | px x=153 y=44 w=75 h=26
    CONTROL "Do you want to leave the game you are currently playing?", -1, "Static", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 8, 10, 182, 13
        // id=-1 (0xFFFF) style=0x50020000 exstyle=0x00000000 | px x=12 y=16 w=273 h=21
    CONTROL "&Yes", 2002, "Button", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 41, 27, 50, 16
        // id=2002 (0x7D2) style=0x50030000 exstyle=0x00000000 | px x=62 y=44 w=75 h=26
END
